    "PUK code info" : {
      "comment" : "My eID PUK code subtitle",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The PUK code is in the ID card's code envelope."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PUK-kood on ID-kaardi koodiümbrikus."
          }
        }
      }
    },
    "PUK code info 2" : {
      "comment" : "My eID Thales card PUK code info",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The PUK code cannot be changed for an identified card. If the code is lost, you can view it in the self-service portal of the Police and Border Guard Board."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuvastatud kaardil ei saa PUK-koodi muuta. Kaotatud koodi saad vaadata Politsei- ja Piirivalveameti iseteenindusest."
          }
        }
      }
    },
    "PUK guideline 1" : {
      "comment" : "My eID PUK guideline",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PUK code is used for unblocking the certificates when PIN1 or PIN2 has been entered 3 times incorrectly."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PUK-koodi abil saab tühistada sertifikaadi blokeeringu, kui PIN1- või PIN2-koodi on 3 korda järjest valesti sisestatud."
          }
        }
      }
    },
    "PUK guideline 2" : {
      "comment" : "My eID PUK guideline",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you forget the PUK code or the certificates remain blocked, you have to visit the service center to obtain new codes."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kui peale vahetamist PUK-kood ununeb ja sertifikaat jääb blokeerituks kolme vale PIN1 või PIN2 sisestamise järel, siis ainus võimalus ID-kaart jälle tööle saada on pöörduda klienditeeninduspunkti poole."
          }
        }
      }
    },
