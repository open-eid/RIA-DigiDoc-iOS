    "PIN1 guideline 1" : {
      "comment" : "My eID PIN1 guideline",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New PIN1 must be different from current PIN1."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uus PIN1 peab olema erinev eelmisest."
          }
        }
      }
    },
    "PIN1 guideline 2" : {
      "comment" : "My eID PIN1 guideline",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PIN1 code is used for authentication."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PIN1-koodi kasutatakse isikutuvastamiseks."
          }
        }
      }
    },
    "PIN1 guideline 3" : {
      "comment" : "My eID PIN1 guideline",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If PIN1 is inserted incorrectly 3 times, the identification certificate will be blocked and it will be impossible to use ID-card to verify identification, until it is unblocked via the PUK code."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kui sisestad PIN1-koodi kolm korda valesti, siis isikutuvastamise sertifikaat blokeeritakse ning ID-kaarti pole võimalik isikutuvastamiseks kasutada enne blokeeringu tühistamist PUK-koodi abil."
          }
        }
      }
    },
    "PIN2 guideline 1" : {
      "comment" : "My eID PIN2 guideline",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New PIN2 must be different from current PIN2."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uus PIN2 peab olema erinev eelmisest."
          }
        }
      }
    },
    "PIN2 guideline 2" : {
      "comment" : "My eID PIN2 guideline",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PIN2 code is used to digitally sign documents."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PIN2-koodi kasutatakse digitaalallkirja andmiseks."
          }
        }
      }
    },
    "PIN2 guideline 3" : {
      "comment" : "My eID PIN2 guideline",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If PIN2 is inserted incorrectly 3 times, the signing certificate will be blocked and it will be impossible to use ID-card for digital signatures, until it is unblocked via the PUK code."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kui sisestad PIN2-koodi kolm korda valesti, siis allkirjastamise sertifikaat blokeeritakse ning ID-kaarti pole võimalik allkirjastamiseks kasutada enne blokeeringu tühistamist PUK-koodi abil."
          }
        }
      }
    },
    "PINs and certificates" : {
      "comment" : "My eID tab title",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
