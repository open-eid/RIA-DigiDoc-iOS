          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "https://www.id.ee/artikkel/id-kaardi-pin-ja-puk-koodide-muutmine/"
          }
        }
      }
    },
    "PUK code" : {
      "comment" : "My eID Thales PUK code title",
      "extractionState" : "manual",
      "localizations" : {
